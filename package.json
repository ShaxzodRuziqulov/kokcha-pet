{
  "name": "kokcha-desktop-pet",
  "version": "1.6.0",
  "description": "Ish stolida yashaydigan kichik yordamchi (desktop pet)",
  "main": "main.js",
  "author": "Forbidd3n",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "uz.forbidd3n.kokcha",
    "productName": "Kokcha",
    "files": [
      "main.js",
      "src/**/*",
      "assets/icon.png",
      "assets/tray.png",
      "!**/node_modules/koffi/build/koffi/{darwin_*,freebsd_*,linux_*,musl_*,openbsd_*,win32_arm64,win32_ia32}/**",
      "!**/node_modules/koffi/{src,vendor,doc}/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kokcha",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Kokcha-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Kokcha-${version}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ShaxzodRuziqulov",
        "repo": "kokcha-pet"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^2.16.3"
  }
}
